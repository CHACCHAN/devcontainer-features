{
    "id": "agents",
    "version": "1.0.9",
    "name": "AI agents",
    "description": "This package integrates CLI functionalities such as Claude, Codex, Antigravity, OpenCode, and Mistral into a single package.",

    "containerEnv": {
        "PATH": "/home/vscode/.local/bin:/home/vscode/.mistral/bin:${PATH}"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "openai.chatgpt",
                "google.google-antigravity",
                "sst-dev.opencode",
                "mistralai.mistral-vibe-code"
            ]
        }
    },

    "options": {
        "claude": {
            "type": "boolean",
            "default": true,
            "description": "Install Claude Code"
        },
        "codex": {
            "type": "boolean",
            "default": true,
            "description": "Install Codex CLI"
        },
        "antigravity": {
            "type": "boolean",
            "default": true,
            "description": "Install Antigravity CLI"
        },
        "opencode": {
            "type": "boolean",
            "default": true,
            "description": "Install OpenCode CLI"
        },
        "mistral": {
            "type": "boolean",
            "default": true,
            "description": "Install Mistral CLI"
        },
        "browser": {
            "type": "string",
            "default": "0.41.2",
            "proposals": ["0.41.2", "none"],
            "description": "agent-browser version (X.Y.Z or vX.Y.Z). Installs matching browser skills for enabled agents. Set none to disable both."
        }
    }
}