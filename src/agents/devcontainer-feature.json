{
    "id": "agents",
    "version": "1.0.4",
    "name": "AI agents",
    "description": "This package integrates CLI functionalities such as Claude, Codex, Antigravity, and OpenCode into a single package.",

    "dependsOn": {
        "ghcr.io/devcontainers/features/node:2": {
            "version": "lts"
        }
    },

    "containerEnv": {
        "PATH": "/home/vscode/.local/bin:${PATH}"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "openai.chatgpt",
                "google.google-antigravity",
                "sst-dev.opencode"
            ]
        }
    },

    "options": {
        "claude": {
            "type": "boolean",
            "default": true,
            "description": "Install Claude Code"
        },
        "codex": {
            "type": "boolean",
            "default": true,
            "description": "Install Codex CLI"
        },
        "antigravity": {
            "type": "boolean",
            "default": true,
            "description": "Install Antigravity CLI"
        },
        "opencode": {
            "type": "boolean",
            "default": true,
            "description": "Install OpenCode CLI"
        },
        "playwright": {
            "type": "boolean",
            "default": true,
            "description": "Install Playwright CLI for browser automation"
        }
    }
}