{
    "id": "agents",
    "version": "1.0.2",
    "name": "AI agents",
    "description": "This package integrates CLI functionalities such as Claude, Codex, and Antigravity into a single package.",

    "containerEnv": {
        "PATH": "/home/vscode/.local/bin:${PATH}"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "openai.chatgpt",
                "google.google-antigravity"
            ]
        }
    },

    "options": {
        "claude": {
            "type": "boolean",
            "default": true,
            "description": "Install Claude Code"
        },
        "codex": {
            "type": "boolean",
            "default": true,
            "description": "Install Codex CLI"
        },
        "antigravity": {
            "type": "boolean",
            "default": true,
            "description": "Install Antigravity CLI"
        }
    }
}